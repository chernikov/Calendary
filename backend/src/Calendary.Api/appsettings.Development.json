{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      // Overrides appsettings.json's "json" back to human-readable — prod/staging (see #300) want
      // JSON lines for docker logs/log-shipping, local dev wants something legible in the terminal.
      "FormatterName": "simple"
    }
  }
}
