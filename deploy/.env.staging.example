# Copy this to /opt/calendary/.env.staging on the droplet (never commit the real file).
# A separate password from prod's — this is a completely separate MSSQL instance/database.
GHCR_OWNER=chernikov
MSSQL_SA_PASSWORD=change-me-to-a-different-strong-password

# Optional — leave blank to keep using MockImageGenerationService (see backend README notes).
# AI_PROVIDER=OpenAI        # or Gemini
# AI_OPENAI_API_KEY=
# AI_GEMINI_API_KEY=

# Optional — leave blank to keep using MockPaymentService. Use a separate sandbox/test merchant
# token here, NOT the same one as prod's .env — a staging checkout should never charge a real card.
# MONOBANK_MERCHANT_TOKEN=

# Optional — leave blank to keep using the small static city/warehouse fallback dataset. Same
# key as prod's .env — a read-only address lookup has no sandbox/live distinction.
# NOVA_POSHTA_API_KEY=

# Optional — leave all blank to disable off-droplet backups (see deploy/backup.sh,
# deploy/RESTORE.md). A separate DO_SPACES_BUCKET/path from prod's is fine — backup.sh already
# scopes each stack to its own restic repo path regardless. RESTIC_PASSWORD encrypts every backup
# — save it somewhere OTHER than this droplet.
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=
# DO_SPACES_REGION=
# RESTIC_PASSWORD=
