# Copy this to /opt/calendary/.env on the droplet (never commit the real file).
# Used by both the edge (Caddy) stack and the prod app stack.
GHCR_OWNER=chernikov
DOMAIN=calendary.com.ua
STAGING_DOMAIN=staging.calendary.com.ua
MSSQL_SA_PASSWORD=change-me-to-a-strong-password

# Optional — leave blank to keep using MockImageGenerationService (see backend README notes).
# AI_PROVIDER=OpenAI        # or Gemini
# AI_OPENAI_API_KEY=
# AI_GEMINI_API_KEY=

# Optional — leave blank to keep using MockPaymentService.
# MONOBANK_MERCHANT_TOKEN=

# Optional — leave blank to keep using the small static city/warehouse fallback dataset.
# NOVA_POSHTA_API_KEY=

# Optional — leave all blank to disable off-droplet backups (see deploy/backup.sh,
# deploy/RESTORE.md). Threaded in from GH secrets on every deploy, same as the keys above — these
# placeholders only matter for a first `bootstrap.sh` run before any deploy has happened yet.
# RESTIC_PASSWORD encrypts every backup — also save it somewhere OTHER than GH/this droplet;
# losing it makes existing backups permanently undecryptable.
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=
# DO_SPACES_REGION=
# RESTIC_PASSWORD=

# Required in practice — without it AdminSeeder logs a warning and skips creating
# admin@calendary.com.ua, leaving no way into /admin short of a manual DB UPDATE. Threaded in
# from the ADMIN_PASSWORD GH secret on every deploy; separate from staging's own password.
# ADMIN_PASSWORD=
